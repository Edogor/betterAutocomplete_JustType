{
  "name": "justtype",
  "displayName": "JustType",
  "description": "A local predictive coding companion that keeps the programmer in control.",
  "version": "0.0.1",
  "publisher": "justtype-local",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "local" },
  "engines": { "vscode": "^1.100.0" },
  "extensionKind": ["workspace"],
  "categories": ["Programming Languages", "Machine Learning"],
  "activationEvents": ["onLanguage:python"],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "justType.toggle", "title": "JustType: Toggle" },
      { "command": "justType.trigger", "title": "JustType: Trigger Completion" },
      { "command": "justType.acceptNextWord", "title": "JustType: Accept Next Word" },
      { "command": "justType.acceptNextLine", "title": "JustType: Accept Next Line" },
      { "command": "justType.dismiss", "title": "JustType: Dismiss Completion" },
      { "command": "justType.checkConnection", "title": "JustType: Check Model Connection" },
      { "command": "justType.showMetrics", "title": "JustType: Show Session Metrics" },
      { "command": "justType.resetMetrics", "title": "JustType: Reset Session Metrics" },
      { "command": "justType.openLog", "title": "JustType: Open Log" }
    ],
    "configuration": {
      "title": "JustType",
      "properties": {
        "justType.enabled": { "type": "boolean", "default": true, "description": "Enable JustType inline completions." },
        "justType.triggerMode": { "type": "string", "enum": ["automatic", "manual"], "default": "automatic", "description": "Request completions automatically after typing or only when explicitly triggered." },
        "justType.llamaCpp.endpoint": { "type": "string", "default": "http://127.0.0.1:8012", "description": "URL of a manually started llama.cpp server." }
      }
    },
    "keybindings": [
      { "key": "tab", "command": "editor.action.inlineSuggest.commit", "when": "inlineSuggestionVisible && editorTextFocus" },
      { "key": "ctrl+right", "command": "justType.acceptNextWord", "when": "inlineSuggestionVisible && editorTextFocus" },
      { "key": "shift+tab", "command": "justType.acceptNextLine", "when": "inlineSuggestionVisible && editorTextFocus" },
      { "key": "escape", "command": "justType.dismiss", "when": "inlineSuggestionVisible && editorTextFocus" }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "build": "npm run check-types && node esbuild.mjs",
    "build:test": "tsc --project tsconfig.test.json",
    "test:unit": "npm run build:test && c8 --reporter=text --reporter=lcov mocha \"out-test/test/unit/**/*.test.js\"",
    "test:extension": "npm run build:test && vscode-test",
    "smoke:llama": "node scripts/llama-smoke.mjs",
    "check": "npm run check-types && npm run lint && npm run test:unit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "npm run check && npm run test:extension && node esbuild.mjs --production && mkdir -p artifacts && vsce package --no-dependencies --out artifacts/justtype-0.0.1.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/mocha": "^10.0.0",
    "@types/vscode": "^1.100.0",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "c8": "^10.1.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "mocha": "^11.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
